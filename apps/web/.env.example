# Copy to .env.local and fill in. NEVER commit real secrets.

# Postgres connection string (Neon free tier recommended).
DATABASE_URL=postgres://user:password@host:5432/rotationplanner

# 32+ byte random string used to sign/derive nothing yet but reserved for
# future token signing. Generate with: openssl rand -base64 48
AUTH_SECRET=replace-me

# Base URL of the deployment (used to build share links). No trailing slash.
APP_URL=http://localhost:3000

# OPTIONAL — distributed rate limiting. If both are set, the auth rate limiter
# uses Upstash Redis (shared across instances, survives restarts) instead of the
# per-instance in-memory limiter. Leave unset for single-instance / local / CI.
# UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=replace-me

# OPTIONAL — error reporting. If set, unhandled route errors are POSTed to
# Sentry via its store endpoint (no SDK). Unset = console logging only.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
